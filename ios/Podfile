platform :ios, '15.1'
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  raise 'Run flutter pub get before pod install' unless File.exist?(generated)
  File.foreach(generated) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise 'FLUTTER_ROOT is missing from Generated.xcconfig'
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)
flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  pod 'DuanjuCore', :path => 'DuanjuCore'
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |configuration|
      configuration.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'
      configuration.build_settings['ENABLE_BITCODE'] = 'NO'
    end
  end
end

post_integrate do |_installer|
  script = File.join(__dir__, 'Pods', 'Target Support Files', 'media_kit_libs_ios_video',
                     'media_kit_libs_ios_video-xcframeworks.sh')
  if File.file?(script)
    marker = '# GuoApp iOS pixel-buffer backend'
    content = File.read(script).split(marker, 2).first
    File.write(script, content.rstrip + "\n" + <<~'SH')
      # GuoApp iOS pixel-buffer backend
      guoapp_mpv="${PODS_ROOT}/../../native/build/ios/mpv/Mpv"
      if [[ "${PLATFORM_NAME}" == "iphoneos" && -f "${guoapp_mpv}" ]]; then
        cp "${guoapp_mpv}" "${PODS_XCFRAMEWORKS_BUILD_DIR}/media_kit_libs_ios_video/Mpv.framework/Mpv"
      fi
    SH
  end
end
