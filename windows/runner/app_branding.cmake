set(APP_DISPLAY_NAME "红果鉴")
set(APP_EXECUTABLE_NAME "hongguojian.exe")
set(APP_PACKAGE_NAME "com.guoapp.phoenix")
set(APP_ALL_SOURCES_DISPLAY_NAME "$ENV{ZHENGUOJIAN_DISPLAY_NAME}")
string(STRIP "${APP_ALL_SOURCES_DISPLAY_NAME}" APP_ALL_SOURCES_DISPLAY_NAME)
if(APP_ALL_SOURCES_DISPLAY_NAME STREQUAL "")
  set(APP_ALL_SOURCES_DISPLAY_NAME "真果鉴")
endif()
set(APP_ALL_SOURCES_PACKAGE_NAME "$ENV{ZHENGUOJIAN_PACKAGE_NAME}")
string(STRIP "${APP_ALL_SOURCES_PACKAGE_NAME}" APP_ALL_SOURCES_PACKAGE_NAME)
if(APP_ALL_SOURCES_PACKAGE_NAME STREQUAL "")
  set(APP_ALL_SOURCES_PACKAGE_NAME "com.guoapp.all")
endif()
foreach(ENTRY IN LISTS FLUTTER_TOOL_ENVIRONMENT)
  if(ENTRY MATCHES "^DART_DEFINES=(.*)$")
    string(REPLACE "," ";" APP_DART_DEFINES "${CMAKE_MATCH_1}")
    foreach(DEFINE IN LISTS APP_DART_DEFINES)
      if(DEFINE STREQUAL "QUxMX1NPVVJDRVM9dHJ1ZQ==")
        set(APP_DISPLAY_NAME "${APP_ALL_SOURCES_DISPLAY_NAME}")
        set(APP_EXECUTABLE_NAME "zhenguojian.exe")
        set(APP_PACKAGE_NAME "${APP_ALL_SOURCES_PACKAGE_NAME}")
      elseif(DEFINE STREQUAL "QUxMX1NPVVJDRVM9ZmFsc2U=")
        set(APP_DISPLAY_NAME "红果鉴")
        set(APP_EXECUTABLE_NAME "hongguojian.exe")
        set(APP_PACKAGE_NAME "com.guoapp.phoenix")
      endif()
    endforeach()
  endif()
endforeach()
